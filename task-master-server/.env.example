# ------------------------------------------------------------------------------
# TaskMaster backend environment (copy to .env for local dev)
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3001

# PostgreSQL (matches docker-compose.yml at repo root)
DATABASE_URL=postgresql://postgres:dev_password@localhost:5432/taskmaster_dev

# JWT / sessions
JWT_ACCESS_SECRET=change_me_to_a_random_string_at_least_32_chars_long
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_ROUNDS=10

# Google OAuth (leave empty locally; /api/auth/google returns 503 until set)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# CORS — the frontend origin (Vite dev server default)
CORS_ORIGIN=http://localhost:5173
